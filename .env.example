# ---- Free AI providers (router tries them automatically; first fast answer wins) ----
# Pollinations works with NO key. Token is optional (higher limits).
POLLINATIONS_TOKEN=
# Hugging Face: https://huggingface.co/settings/tokens  (read token, "Inference Providers" permission)
HF_TOKEN=
# Optional extra fallbacks (all have free tiers)
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# ---- Optional tuning ----
# AI_PROVIDER_ORDER=pollinations,huggingface,groq,openrouter,gemini
# POLLINATIONS_MODEL=openai-fast
# HF_MODEL=meta-llama/Llama-3.3-70B-Instruct
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# GEMINI_MODEL=gemini-3.8-flash
# AI_HEDGE_MS=2500      # start the next provider if the first is slower than this
# AI_TIMEOUT_MS=12000
# AI_MAX_TOKENS=600

# ---- Terminal (production) ----
# Off by default when hosted. For personal use just turn it on:
ENABLE_TERMINAL=true
# Optional: leave empty for personal use (the app has no field to enter a token yet).
# TERMINAL_TOKEN=
PORT=3000
